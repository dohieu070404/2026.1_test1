{
  "name": "smart-insole-mobile-expo",
  "version": "1.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --go --port 8082",
    "android": "expo start --go --android --port 8082",
    "start:dev": "expo start --dev-client --port 8082",
    "android:dev": "expo run:android --port 8082",
    "prebuild:android": "expo prebuild --platform android",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest --runInBand",
    "check": "npm run typecheck && npm run lint && npm test",
    "export:android": "expo export --platform android --output-dir dist/android",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "expo": "~58.0.25",
    "expo-status-bar": "~58.0.5",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-secure-store": "~58.0.3",
    "expo-sqlite": "~58.0.17",
    "expo-build-properties": "~58.0.12",
    "expo-dev-client": "~58.0.20",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-ble-plx": "3.5.0",
    "react-native-url-polyfill": "2.0.0",
    "uuid": "11.1.0",
    "base64-js": "1.5.1",
    "expo-system-ui": "~58.0.7"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "jest": "^29.7.0",
    "jest-expo": "~58.0.14",
    "@types/jest": "^29.5.14",
    "react-test-renderer": "19.3.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.6.2",
    "expo-doctor": "^1.17.0",
    "babel-preset-expo": "~58.0.25"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  }
}
